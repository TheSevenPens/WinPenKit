<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In the solution and in the release, and not in the NuGet package.

    Those are different audiences. The release is downloaded by somebody who wants to run
    something; a diagnostic for a driver that has stopped handing out contexts is exactly the
    sort of thing they want, already built. The package is referenced by somebody writing an
    application, who wants a library and not a bag of tools.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>WintabContexts</RootNamespace>
    <AssemblyName>WintabContexts</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WinPenKit\WinPenKit.csproj" />
  </ItemGroup>

</Project>
