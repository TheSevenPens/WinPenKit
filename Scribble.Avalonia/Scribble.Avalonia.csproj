<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Scribble.Avalonia</RootNamespace>
    <AssemblyName>Scribble.Avalonia</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Win32 + Avalonia.Skia rather than the Avalonia.Desktop metapackage, which
         also pulls the X11, FreeDesktop and macOS backends this Windows-only app can never
         load. Avalonia.Win32 does not depend on Avalonia.Skia, so both are named. -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Win32" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <!-- Avalonia 12 split text shaping out of Skia. UsePlatformDetect registers HarfBuzz;
         naming backends does not, and the app throws "No text shaping system configured"
         on startup without it. -->
    <PackageReference Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinPenKit\WinPenKit.csproj" />
    <ProjectReference Include="..\WinPenKit.Avalonia\WinPenKit.Avalonia.csproj" />
  </ItemGroup>

</Project>
