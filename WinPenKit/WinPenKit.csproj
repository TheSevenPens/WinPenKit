<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <RootNamespace>WinPenKit</RootNamespace>
    <AssemblyName>WinPenKit</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinPenKit.TestConsole" />
    <!-- The mapping wizard reports which desktop map a Wintab session chose. -->
    <InternalsVisibleTo Include="WinPenKit.MappingWizard" />
  </ItemGroup>

</Project>
